<UserControl x:Class="Ledge.App.Controls.DockTab"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Ledge.App.Controls"
 Width="216" Height="76" Cursor="Hand" MouseEnter="Tab_MouseEnter" MouseLeave="Tab_MouseLeave">
 <local:ContinuousSurface x:Name="TabBorder" CornerRadius="12" Padding="14,12" Elevation="5"
         Background="{DynamicResource MossNoteBrush}" BorderBrush="{DynamicResource CardEdgeBrush}" BorderThickness="1"
         MouseLeftButtonDown="Tab_MouseLeftButtonDown">
  <local:ContinuousSurface.RenderTransform><TranslateTransform x:Name="Slide"/></local:ContinuousSurface.RenderTransform>
  <Grid>
   <Path x:Name="PaperFold" Data="M0,18 Q15,17 18,0 L18,18 Z" Fill="#70FFFFFF" Stroke="#26000000" StrokeThickness="0.7" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-13,-11" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5"/>
   <StackPanel x:Name="FullContent">
    <DockPanel Margin="0,0,0,6">
     <Ellipse x:Name="PinnedDot" Style="{StaticResource LabelDot}" Width="5" Height="5" Fill="{DynamicResource AccentBrush}" Margin="0,0,6,0" Visibility="Collapsed"/>
     <TextBlock x:Name="HeaderWord" Style="{StaticResource DotLabelText}" FontFamily="{StaticResource UIFont}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
    </DockPanel>
    <TextBlock x:Name="BodyText" FontFamily="{StaticResource UIFont}" FontSize="12" LineHeight="17" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="20"/>
   </StackPanel>
   <TextBlock x:Name="PeekWord" Width="84" HorizontalAlignment="Left" VerticalAlignment="Center"
              FontFamily="{StaticResource UIFont}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis" Visibility="Hidden"/>
  </Grid>
 </local:ContinuousSurface>
</UserControl>

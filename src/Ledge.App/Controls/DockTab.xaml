<UserControl x:Class="Ledge.App.Controls.DockTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="220"
             MinHeight="56"
             Margin="0,3"
             Cursor="Hand">
    <Border x:Name="TabBorder"
            Background="#C7D2B8"
            CornerRadius="6"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            Padding="10,8"
            MouseLeftButtonDown="TabBorder_MouseLeftButtonDown"
            MouseEnter="TabBorder_MouseEnter"
            MouseLeave="TabBorder_MouseLeave">
        <Border.Effect>
            <DropShadowEffect x:Name="TabShadow"
                              Color="#000000"
                              BlurRadius="8"
                              ShadowDepth="2"
                              Opacity="0.15"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header: Pin dot, preview / first word, timestamp -->
            <Grid Grid.Row="0" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Pinned indicator -->
                <Ellipse x:Name="PinnedDot"
                         Grid.Column="0"
                         Width="6" Height="6"
                         Fill="{StaticResource AccentBrush}"
                         VerticalAlignment="Center"
                         Margin="0,0,6,0"
                         Visibility="Collapsed"/>

                <!-- First line / header -->
                <TextBlock x:Name="HeaderWord"
                           Grid.Column="1"
                           Text="Note"
                           FontFamily="{StaticResource UIFont}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#1B1D22"
                           TextTrimming="CharacterEllipsis"/>

                <!-- Timestamp -->
                <TextBlock x:Name="TimestampText"
                           Grid.Column="2"
                           Text="just now"
                           FontFamily="{StaticResource UIFont}"
                           FontSize="10"
                           Foreground="#1B1D22"
                           Opacity="0.5"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Body: note text -->
            <TextBlock x:Name="BodyText"
                       Grid.Row="1"
                       Text=""
                       FontFamily="{StaticResource UIFont}"
                       FontSize="12"
                       Foreground="#1B1D22"
                       LineHeight="16"
                       TextWrapping="Wrap"
                       MaxHeight="48"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Border>
</UserControl>
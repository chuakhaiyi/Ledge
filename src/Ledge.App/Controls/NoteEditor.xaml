<UserControl x:Class="Ledge.App.Controls.NoteEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Ledge.App.Controls">

    <local:ContinuousSurface x:Name="ChromeSurface" Background="{DynamicResource MaterialBrush}"
            CornerRadius="22" Elevation="12"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Titlebar -->
            <Border Grid.Row="0" Background="Transparent">
                <Grid Margin="6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- New note button -->
                    <Button Grid.Column="0"
                            x:Name="NewNoteButton"
                            Style="{StaticResource IconButton}"
                            Click="NewNoteButton_Click"
                            ToolTip="New note (Ctrl+Alt+N)">
                        <Path Data="M5,0 L5,10 M0,5 L10,5"
                              Stroke="{DynamicResource SecondaryTextBrush}"
                              StrokeThickness="1.5" Width="10" Height="10"/>
                    </Button>

                    <!-- Drag area in center -->
                    <Border Grid.Column="1" Background="Transparent"/>

                    <!-- Action buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Pin button -->
                        <Button x:Name="PinButton"
                                Style="{StaticResource IconButton}"
                                Click="PinButton_Click"
                                ToolTip="Pin note to dock">
                            <Path x:Name="PinIcon"
                                  Data="M4,1 L10,1 M5,1 L5,6 L3,9 L11,9 L9,6 L9,1 M7,9 L7,14"
                                  Stroke="{DynamicResource SecondaryTextBrush}"
                                  Fill="Transparent"
                                  StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14"/>
                        </Button>

                        <!-- Color picker -->
                        <Button x:Name="ColorButton"
                                Style="{StaticResource IconButton}"
                                Click="ColorButton_Click"
                                ToolTip="Change color (Ctrl+.)">
                            <Grid Width="18" Height="18">
                                <Ellipse x:Name="ColorIndicator" Fill="{DynamicResource MossNoteBrush}" Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="1"/>
                            </Grid>

                        </Button>

                        <!-- Close note window -->
                        <Button x:Name="CloseButton"
                                Style="{StaticResource IconButton}"
                                Click="CloseButton_Click"
                                ToolTip="Close (Esc)">
                            <Path Data="M0,0 L10,10 M10,0 L0,10"
                                  Stroke="{DynamicResource SecondaryTextBrush}"
                                  StrokeThickness="1.5" Width="10" Height="10"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Popup x:Name="ColorPopup" PlacementTarget="{Binding ElementName=ColorButton}" Placement="Bottom"
                   StaysOpen="False" AllowsTransparency="True" Opened="ColorPopup_Opened" Closed="ColorPopup_Closed">
                <local:ContinuousSurface x:Name="PaletteSurface" Background="{DynamicResource MaterialBrush}" BorderBrush="{DynamicResource BorderBrush}"
                     BorderThickness="1" CornerRadius="20" Elevation="12" Margin="14" Padding="16" RenderTransformOrigin="0.75,0">
                    <local:ContinuousSurface.RenderTransform><TranslateTransform x:Name="PaletteSlide"/></local:ContinuousSurface.RenderTransform>
                    <StackPanel KeyboardNavigation.TabNavigation="Cycle">
                        <TextBlock Text="Note color" Style="{StaticResource UIText}" FontSize="13" FontWeight="SemiBold" Margin="2,0,0,12"/>
                        <ItemsControl x:Name="ColorChoices">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Button Width="38" Height="38" Margin="3" Background="{Binding ColorBrush}"
                                        ToolTip="{Binding ColorName}" AutomationProperties.Name="{Binding ColorName}" Click="ColorChip_Click">
                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SwatchButton}">
                                        <Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderThickness" Value="2"/>
                                            <Setter Property="Content" Value="Selected"/>
                                        </DataTrigger></Style.Triggers>
                                    </Style></Button.Style>
                                </Button>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </local:ContinuousSurface>
            </Popup>
            <!-- Editor -->
            <Border x:Name="NoteSurface" Grid.Row="1">
            <TextBox x:Name="TextBox"
                     Style="{StaticResource NoteTextBox}"
                     TextChanged="TextBox_TextChanged"
                     Margin="22,20,22,20"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     SpellCheck.IsEnabled="True"
                     FontFamily="{StaticResource UIFont}"
                     FontSize="15"
                     Foreground="{DynamicResource PrimaryTextBrush}"/>
            </Border>

            <!-- Footer -->
            <Grid Grid.Row="2" Margin="18,8,14,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TimestampText"
                           Grid.Column="0"
                           Style="{StaticResource TimestampText}"
                           VerticalAlignment="Center"
                           Text="Local note"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse x:Name="PinDot" Style="{StaticResource LabelDot}" Width="6" Height="6" Fill="{DynamicResource AccentBrush}"
                             VerticalAlignment="Center" Margin="0,0,5,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="PinText"
                               Style="{StaticResource DotLabelText}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="Pinned"
                               Visibility="Collapsed"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Style="{StaticResource IconButton}"
                        Click="DeleteButton_Click"
                        ToolTip="Delete note (Ctrl+Backspace)">
                    <Path Data="M2,3 L12,3 M4,3 L4,12 L10,12 L10,3 M5,1 L9,1 M6,5 L6,10 M8,5 L8,10"
                          Stroke="{DynamicResource SecondaryTextBrush}"
                          StrokeThickness="1.2" Width="14" Height="14"/>
                </Button>
            </Grid>
        </Grid>
    </local:ContinuousSurface>
</UserControl>

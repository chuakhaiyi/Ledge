<UserControl x:Class="Ledge.App.Controls.NoteEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Ledge.App.Controls">

    <Border Background="{StaticResource BackgroundBrush}"
            CornerRadius="8"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Titlebar -->
            <Border Grid.Row="0" Background="{StaticResource OverlayBrush}" CornerRadius="8,8,0,0">
                <Grid Margin="6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- New note button -->
                    <Button Grid.Column="0"
                            x:Name="NewNoteButton"
                            Style="{StaticResource IconButton}"
                            Click="NewNoteButton_Click"
                            ToolTip="New note (Ctrl+Alt+N)">
                        <Path Data="M5,0 L5,10 M0,5 L10,5"
                              Stroke="{StaticResource SecondaryTextBrush}"
                              StrokeThickness="1.5" Width="10" Height="10"/>
                    </Button>

                    <!-- Drag area in center -->
                    <Border Grid.Column="1" Background="Transparent"/>

                    <!-- Action buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Pin button -->
                        <Button x:Name="PinButton"
                                Style="{StaticResource IconButton}"
                                Click="PinButton_Click"
                                ToolTip="Pin note to dock">
                            <Path x:Name="PinIcon"
                                  Data="M3,1 L9,1 M6,1 L6,3 M2,3 L10,3 L8,8 L7,8 L7,13 L5,13 L5,8 L4,8 Z"
                                  Stroke="{StaticResource SecondaryTextBrush}"
                                  Fill="Transparent"
                                  StrokeThickness="1.2" Width="12" Height="14"/>
                        </Button>

                        <!-- Color picker -->
                        <Button x:Name="ColorButton"
                                Style="{StaticResource IconButton}"
                                Click="ColorButton_Click"
                                ToolTip="Change color (Ctrl+.)">
                            <Grid Width="16" Height="16">
                                <Ellipse x:Name="ColorIndicator" Fill="#C7D2B8" Stroke="{StaticResource BorderBrush}" StrokeThickness="1"/>
                            </Grid>
                            <Button.ContextMenu>
                                <ContextMenu x:Name="ColorPopup" PlacementTarget="{Binding ElementName=ColorButton}" Placement="Bottom">
                                    <ContextMenu.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" Columns="8"/>
                                        </ItemsPanelTemplate>
                                    </ContextMenu.ItemsPanel>
                                    <ContextMenu.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="28" Height="28" Margin="4" CornerRadius="4" Background="{Binding ColorBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                    Cursor="Hand" ToolTip="{Binding ColorName}"
                                                    MouseLeftButtonDown="ColorChip_Click">
                                            </Border>
                                        </DataTemplate>
                                    </ContextMenu.ItemTemplate>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <!-- Close note window -->
                        <Button x:Name="CloseButton"
                                Style="{StaticResource IconButton}"
                                Click="CloseButton_Click"
                                ToolTip="Close (Esc)">
                            <Path Data="M0,0 L10,10 M10,0 L0,10"
                                  Stroke="{StaticResource SecondaryTextBrush}"
                                  StrokeThickness="1.5" Width="10" Height="10"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Editor -->
            <TextBox x:Name="TextBox"
                     Grid.Row="1"
                     Style="{StaticResource NoteTextBox}"
                     TextChanged="TextBox_TextChanged"
                     Margin="18,18,18,14"
                     MinHeight="130"
                     AcceptsReturn="True"
                     SpellCheck.IsEnabled="True"
                     FontFamily="{StaticResource UIFont}"
                     FontSize="15"
                     Foreground="{StaticResource PrimaryTextBrush}"/>

            <!-- Footer -->
            <Grid Grid.Row="2" Margin="18,0,18,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TimestampText"
                           Grid.Column="0"
                           Style="{StaticResource TimestampText}"
                           VerticalAlignment="Center"
                           Text="edited just now"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Ellipse x:Name="PinDot" Width="6" Height="6" Fill="{StaticResource AccentBrush}"
                             VerticalAlignment="Center" Margin="0,0,5,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="PinText"
                               Style="{StaticResource TimestampText}"
                               Text="pinned"
                               Visibility="Collapsed"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Style="{StaticResource IconButton}"
                        Click="DeleteButton_Click"
                        ToolTip="Delete note (Ctrl+Backspace)">
                    <Path Data="M2,3 L12,3 M4,3 L4,12 L10,12 L10,3 M5,1 L9,1 M6,5 L6,10 M8,5 L8,10"
                          Stroke="{StaticResource SecondaryTextBrush}"
                          StrokeThickness="1.2" Width="14" Height="14"/>
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
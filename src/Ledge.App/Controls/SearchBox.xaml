<UserControl x:Class="Ledge.App.Controls.SearchBox"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid>
  <TextBox x:Name="SearchTextBox" Style="{StaticResource SearchBox}" Padding="36,10,12,10"
           TextAlignment="Left" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
           AutomationProperties.Name="Search notes" TextChanged="SearchTextBox_TextChanged"/>
  <Path Data="M11,6 A5,5 0 1 1 1,6 A5,5 0 1 1 11,6 M10,10 L15,15"
        Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.5" Width="16" Height="16"
        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/>
  <TextBlock Text="{Binding Placeholder, RelativeSource={RelativeSource AncestorType=UserControl}}"
             Margin="37,0,12,0" VerticalAlignment="Center" IsHitTestVisible="False">
   <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
    <Setter Property="Visibility" Value="Collapsed"/>
    <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
   </Style></TextBlock.Style>
  </TextBlock>
 </Grid>
</UserControl>

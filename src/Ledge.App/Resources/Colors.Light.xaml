<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light Mode Colors -->
    <Color x:Key="InkColor">#1B1D22</Color>
    <Color x:Key="PaperColor">#EAE6DC</Color>
    <Color x:Key="CopperColor">#B5642C</Color>
    <Color x:Key="PineColor">#4B5A45</Color>
    <Color x:Key="AshColor">#8A8D91</Color>
    <Color x:Key="PaperHiColor">#F3F0E8</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource PaperColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource PaperHiColor}"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource InkColor}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource AshColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource CopperColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource PineColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E8E0D4"/>
    <SolidColorBrush x:Key="EdgeRuleBrush" Color="#8A8D91" Opacity="0.35"/>
    <SolidColorBrush x:Key="FocusRingBrush" Color="{StaticResource CopperColor}"/>
    <SolidColorBrush x:Key="DisabledBrush" Color="#8A8D91" Opacity="0.5"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="#1B1D22" Opacity="0.06"/>
    <SolidColorBrush x:Key="ShadowBrush" Color="#000000" Opacity="0.4"/>

    <!-- Note Colors -->
    <Color x:Key="ButterColor">#F0DFAE</Color>
    <Color x:Key="ClayColor">#E7C3AE</Color>
    <Color x:Key="MossColor">#C7D2B8</Color>
    <Color x:Key="SkyColor">#BFD2D6</Color>
    <Color x:Key="BlushColor">#E3C6C6</Color>
    <Color x:Key="SlateColor">#C7CBD1</Color>
    <Color x:Key="SandColor">#DED3BD</Color>
    <Color x:Key="InkNoteColor">#B9BCC2</Color>
</ResourceDictionary>
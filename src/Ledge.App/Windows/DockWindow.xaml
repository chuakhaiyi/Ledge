<Window x:Class="Ledge.App.Windows.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Ledge.App.Controls"
        Style="{StaticResource BorderlessWindow}"
        Width="220"
        Height="{x:Static SystemParameters.PrimaryScreenHeight}"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged"
        KeyDown="Window_KeyDown"
        Focusable="False"
        SourceInitialized="Window_SourceInitialized">
    <Window.Resources>
        <local:NoteToDockTabConverter x:Key="NoteToTabConverter"/>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Collapsed edge indicator -->
        <Border x:Name="CollapsedEdge"
                Grid.Column="0"
                Background="{StaticResource AccentBrush}"
                Width="20"
                Visibility="Visible">
            <Border.ToolTip>
                <TextBlock Text="Ledge — hover to peek" Foreground="White" FontSize="11" Padding="8,4"/>
            </Border.ToolTip>
        </Border>

        <!-- Expanded dock area -->
        <Border x:Name="ExpandedArea"
                Grid.Column="1"
                Background="{StaticResource BackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0"
                Visibility="Collapsed"
                Width="200">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Pinned section -->
                <ItemsControl x:Name="PinnedTabs"
                              Grid.Row="0"
                              ItemsSource="{Binding PinnedNotes, RelativeSource={RelativeSource AncestorType=Window}}"
                              ItemTemplate="{StaticResource DockTabTemplate}"
                              Visibility="Visible">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Hotzone for hover detection -->
                <Border x:Name="Hotzone"
                        Grid.Row="1"
                        Background="Transparent"
                        MouseEnter="Hotzone_MouseEnter"
                        MouseLeave="Hotzone_MouseLeave">
                    <ItemsControl x:Name="TabsList"
                                  ItemsSource="{Binding VisibleUnpinnedNotes, RelativeSource={RelativeSource AncestorType=Window}}"
                                  ItemTemplate="{StaticResource DockTabTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Border>

                <!-- Overflow indicator -->
                <Border x:Name="OverflowTab"
                        Grid.Row="2"
                        Height="40"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Visibility="Collapsed"
                        Cursor="Hand"
                        MouseLeftButtonDown="OverflowTab_MouseLeftButtonDown"
                        ToolTip="Open all notes">
                    <TextBlock Text="+ more notes"
                               Style="{StaticResource SecondaryText}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
<Window x:Class="Ledge.App.Windows.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Ledge.App.Controls"
        xmlns:models="clr-namespace:Ledge.App.Windows"
        Title="Ledge"
        Icon="/Ledge.App;component/assets/icon.ico"
        Width="760" Height="700"
        MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BackgroundBrush}"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <local:NoteRowConverter x:Key="NoteRowConverter"/>
        <Style x:Key="NotesListStyle" TargetType="ListView" BasedOn="{StaticResource NotesListView}">
            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling"/>
        </Style>
    </Window.Resources>

    <local:ContinuousSurface Margin="12" CornerRadius="28" Background="{DynamicResource SurfaceBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,24">
            <TextBlock Text="Ledge" Style="{StaticResource DisplayText}" FontSize="18" VerticalAlignment="Center" Margin="0,0,24,0"/>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="NotesNavigation" Content="All Notes" GroupName="View" Style="{StaticResource NavigationButton}" IsChecked="True" Click="NotesNavigation_Click"/>
                <RadioButton x:Name="SettingsNavigation" Content="Settings" GroupName="View" Style="{StaticResource NavigationButton}" Click="SettingsNavigation_Click"/>
            </StackPanel>
        </DockPanel>
        <ContentControl x:Name="SettingsHost" Grid.Row="1" Visibility="Collapsed"/>
        <Grid x:Name="LibraryContent" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title + New Note + Sort -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Your notes"
                           Style="{StaticResource DisplayText}"
                           FontSize="26"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Content="+ New Note"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Click="NewNote_Click"/>

                <ComboBox x:Name="SortComboBox"
                          Grid.Column="2"
                          Width="150"
                          Style="{StaticResource SettingsComboBox}"
                          SelectionChanged="SortComboBox_SelectionChanged"
                          VerticalAlignment="Center"/>
            </Grid>

            <!-- Search -->
            <local:SearchBox x:Name="SearchBox"
                             Grid.Row="1"
                             Placeholder="Search notes"
                             SearchTextChanged="SearchBox_SearchTextChanged"
                             Margin="0,0,0,26"/>

            <!-- Notes list -->
            <ScrollViewer Grid.Row="2" Style="{StaticResource ThinScrollViewer}">
                <StackPanel x:Name="NotesPanel"/>
            </ScrollViewer>
        </Grid>
    </Grid>
    </local:ContinuousSurface>
</Window>

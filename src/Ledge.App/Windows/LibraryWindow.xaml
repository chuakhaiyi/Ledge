<Window x:Class="Ledge.App.Windows.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Ledge.App.Controls"
        xmlns:models="clr-namespace:Ledge.App.Windows"
        Title="Ledge — All Notes"
        Width="620" Height="700"
        MinWidth="500" MinHeight="400"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BackgroundBrush}"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <local:NoteRowConverter x:Key="NoteRowConverter"/>
        <Style x:Key="NotesListStyle" TargetType="ListView" BasedOn="{StaticResource NotesListView}">
            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Edge rule -->
        <Border Grid.Column="0" Background="{StaticResource EdgeRuleBrush}" Width="1"/>

        <Grid Grid.Column="1" Margin="24,26,28,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title + New Note + Sort -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Your notes"
                           Style="{StaticResource DisplayText}"
                           FontSize="26"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Content="+ New Note"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Click="NewNote_Click"/>

                <ComboBox x:Name="SortComboBox"
                          Grid.Column="2"
                          SelectedItem="{Binding SortMode, RelativeSource={RelativeSource AncestorType=Window}}"
                          Width="140"
                          Style="{StaticResource SettingsComboBox}"
                          SelectionChanged="SortComboBox_SelectionChanged"
                          VerticalAlignment="Center"/>
            </Grid>

            <!-- Search -->
            <local:SearchBox x:Name="SearchBox"
                             Grid.Row="1"
                             Placeholder="Search notes"
                             SearchTextChanged="SearchBox_SearchTextChanged"
                             Margin="0,0,0,26"/>

            <!-- Notes list -->
            <ScrollViewer Grid.Row="2" Style="{StaticResource ThinScrollViewer}">
                <StackPanel x:Name="NotesPanel"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>